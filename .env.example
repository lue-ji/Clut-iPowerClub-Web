# Google Apps Script Web App URL（部署 URL，結尾通常為 /exec）
# 正式環境請在 Vercel → Settings → Environment Variables 設定同名變數。
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_YOUR_SCRIPT_ID/exec

# GAS Script Properties 中 API_TOKEN 的相同值；請使用隨機產生的長字串。
GAS_API_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN

# 選用：API 逾時與重試（GET 微笑牆適用；POST 報名不重試）
VITE_API_TIMEOUT=30000
VITE_API_RETRY_COUNT=5
VITE_API_RETRY_DELAY=2000
